{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What jterm's windows are allowed to ask of the system. `w-*` is a workspace window opened during the session: it is the same page as `main` and needs the same permissions, so the pattern is here rather than a second capability that would drift from this one.",
  "windows": [
    "main",
    "settings",
    "w-*"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "opener:allow-open-url",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "core:window:allow-destroy",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "opener:allow-open-path",
    "core:event:allow-emit-to",
    "core:event:allow-unlisten",
    "core:webview:allow-get-all-webviews",
    "core:window:allow-title"
  ]
}
